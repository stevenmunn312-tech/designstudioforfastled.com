# Committed on purpose: these are public values, and pinning them here is what
# stops a developer's .env.local from deciding what a production build ships.
#
# Load order is process.env > .env.$NODE_ENV.local > .env.local > .env.$NODE_ENV
# (https://nextjs.org/docs/app/guides/environment-variables). This file is only
# read when NODE_ENV=production, i.e. `next build`. Keep dev-machine overrides
# in .env.development.local, which a production build never reads — .env.local
# outranks this file, so a site URL left there would silently ship.
#
# NEXT_PUBLIC_* values are inlined into the bundle at build time. This one feeds
# metadataBase (OG/Twitter image URLs) and the Supabase signup confirmation
# redirect, so a localhost value here breaks link previews and email sign-up.
NEXT_PUBLIC_SITE_URL=https://designstudioforfastled.com
