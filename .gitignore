# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# editor / agent tooling
# Per-machine Claude Code state: approved-permission lists and the local
# launch.json used to start the dev server in the preview pane.
/.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-*.log
# Redirected `next dev` output, one file per port (.next-dev-3100.log etc).
.next-dev-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.dev.vars.example
# Public build-time values for production. Committed so a local .env.local
# cannot decide what a deployed build ships — see the file's own header.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
