{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "design-studio-for-fastled",
  // Wraps .open-next/worker.js; see the comment at the top of the file.
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "designstudioforfastled.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Private bucket of unreleased app builds, served only through the secret
  // /preview/<code> pages. The bucket has no public access of its own.
  "r2_buckets": [
    { "binding": "PREVIEW_BUILDS", "bucket_name": "design-studio-preview-builds" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "design-studio-for-fastled"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
