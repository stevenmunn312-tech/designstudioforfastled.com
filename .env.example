NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NEXT_PUBLIC_SITE_URL is deliberately absent. Production reads it from the
# committed .env.production; setting it in .env.local would override that file
# and ship a localhost URL to the deployed site. If your dev server runs on a
# non-default host or port, put the override in .env.development.local, which
# `next build` never reads.
